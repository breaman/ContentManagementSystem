<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
  </PropertyGroup>

  <ItemGroup>
    <!-- axe-core runs inside the Playwright page, so accessibility assertions live alongside the
         browser journeys rather than in a suite of their own (task P0-11, P1-31). -->
    <PackageReference Include="Deque.AxeCore.Playwright" />
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>

  <ItemGroup>
    <!-- The structure screens are rendered here with the framework's static HtmlRenderer, so the
         a11y gate needs the components themselves and the ASP.NET Core component runtime. -->
    <ProjectReference Include="..\..\src\ContentManagementSystem.Client\ContentManagementSystem.Client.csproj" />
    <!-- The public half of the accessibility gate renders CmsDeliveryDocument itself rather than a
         re-creation of it (task P9-07). The document is the Server's, and a gate that judged a
         look-alike would go green on a shell nobody serves. -->
    <ProjectReference Include="..\..\src\ContentManagementSystem.Server\ContentManagementSystem.Server.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>

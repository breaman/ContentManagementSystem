<!--
  Shared settings for every test project. Imports the repository-root props first so tests inherit
  the same target framework, nullable, and warnings-as-errors settings as production code.
-->
<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Test assemblies are not consumed as libraries, so public XML docs are not required. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Everything under tests/ named *.Tests is a runnable suite; anything else (TestSupport)
         is a plain helper library that must not be discovered by the test runner. -->
    <IsTestProject Condition="$(MSBuildProjectName.EndsWith('.Tests'))">true</IsTestProject>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <!-- TUnit is the test framework for this repository. It runs on Microsoft.Testing.Platform,
         which means the runner is compiled into the test assembly itself: the project becomes an
         executable (TUnit.Engine.props sets OutputType), and there is deliberately no
         Microsoft.NET.Test.Sdk and no coverlet.collector — either one hijacks the entry point and
         discovery finds nothing. TRX reporting and code coverage come from the meta-package.

         Note that unlike xUnit, TUnit runs the tests *within* a class in parallel as well as
         across classes. Suites that share a resource say so with [NotInParallel(key)]. -->
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <!-- TUnit contributes its own implicit usings (TUnit.Core, and HookType statically, which is
         what makes [Before(Test)] read the way it does), so only the assertion library is listed. -->
    <Using Include="FluentAssertions" />
  </ItemGroup>

</Project>

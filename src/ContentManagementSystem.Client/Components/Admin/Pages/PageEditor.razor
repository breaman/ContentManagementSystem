@page "/admin/pages/{Id:int}"
@rendermode InteractiveWebAssembly
@attribute [Authorize(Roles = CmsRoles.ContentReaders)]
@using ContentManagementSystem.Client.Components.Admin.Canvas
@using ContentManagementSystem.Shared.Contracts.Content
@using ContentManagementSystem.Shared.Contracts.Security

<PageTitle>@(Page?.Summary.Title ?? "Page")</PageTitle>

@if (Page is null)
{
    <p role="status">Loading page…</p>
}
else
{
    <nav aria-label="Breadcrumb">
        <a href="/admin/pages">← All pages</a>
    </nav>

    <h1>@Page.Summary.Title</h1>
    <p class="text-body-secondary">
        <code>@Page.Summary.Slug</code> · template <code>@Page.Summary.TemplateKey</code>
        revision @Page.TemplateRevision · draft v@Page.Summary.DraftVersionNumber
        @if (Page.Summary.PublishedVersionNumber is { } published)
        {
            <text> · published v@published</text>
        }
    </p>

    @if (Page.Summary.HasUnpublishedChanges)
    {
        <p class="alert alert-warning" role="status">
            This draft has moved on from what is published. The public site still shows
            v@Page.Summary.PublishedVersionNumber until you publish again.
        </p>
    }

    @if (Notice is { Length: > 0 })
    {
        <p class="alert alert-success" role="status">@Notice</p>
    }

    @* The pinned-version affordance of spec section 9.2, on the page rather than on the item —
       the pin is a property of the placement, so the person who can clear it is the person editing
       the page. It renders nothing at all when no placement on this page is pinned. *@
    <PinnedPlacements Page="Page" OnUpdated="ReloadAsync" />

    @if (Slots is null)
    {
        <p role="status">Loading zones…</p>
    }
    else
    {
        <EditingCanvas Zones="Slots"
                       Diagnostics="Diagnostics"
                       Disabled="@(IsBusy || !CanEdit)"
                       PageErrorHeading="@ErrorHeading"
                       Status="@StatusLine">

            <Editor Context="zone">
                <PlainZoneEditor Field="zone"
                                 Value="@Values.GetValueOrDefault(zone.Zone.Key, string.Empty)"
                                 ValueChanged="value => OnZoneChanged(zone.Zone.Key, value)" />
            </Editor>

            <EmptyState>
                <p>
                    This template's revision @Page.TemplateRevision captured no zones, so there is
                    nothing to fill in.
                    <a href="@($"/admin/structure/templates/{Page.Summary.TemplateId}")">Add some</a>,
                    then republish the page to adopt them.
                </p>
            </EmptyState>

            <Actions>
                <AuthorizeView Roles="@CmsRoles.ContentEditors" Context="editor">
                    <button type="button" class="btn btn-primary" disabled="@IsBusy"
                            @onclick="SaveAsync">
                        Save draft
                    </button>
                </AuthorizeView>

                <button type="button" class="btn btn-outline-secondary" disabled="@IsBusy"
                        @onclick="ValidateAsync">
                    Check before publishing
                </button>

                <AuthorizeView Roles="@CmsRoles.ContentPublishers" Context="publisher">
                    <button type="button" class="btn btn-success" disabled="@IsBusy"
                            @onclick="PublishAsync">
                        @(AcknowledgeWarnings ? "Publish anyway" : "Publish")
                    </button>

                    @if (Page.Summary.PublishedVersionNumber is not null)
                    {
                        <button type="button" class="btn btn-outline-danger" disabled="@IsBusy"
                                @onclick="UnpublishAsync">
                            Unpublish
                        </button>
                    }
                </AuthorizeView>
            </Actions>

        </EditingCanvas>
    }

    <div class="d-flex gap-2 mt-3">
        @* target="_blank" on purpose: preview is a look at another version, not a place to be
           navigated to — an editor who lost their unsaved form to it would not use it twice. *@
        <a class="btn btn-outline-secondary" href="@($"/preview/{Id}")" target="_blank"
           rel="noopener">Preview draft</a>
        <a class="btn btn-outline-secondary" href="@($"/admin/pages/{Id}/preview-links")">Preview links</a>
        <a class="btn btn-outline-secondary" href="@($"/admin/pages/{Id}/versions")">Version history</a>
    </div>
}

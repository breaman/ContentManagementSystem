@using ContentManagementSystem.Client.Components.Admin.Structure
@using ContentManagementSystem.Shared.Contracts.Media
@using ContentManagementSystem.Shared.Contracts.Security
@using Microsoft.AspNetCore.Components.Forms

<DiagnosticList Diagnostics="Errors" Heading="That did not happen" />

@if (Notice is { Length: > 0 })
{
    <p class="alert alert-success" role="status">@Notice</p>
}

<div class="row">
    <div class="col-md-3">
        <h2 class="h6">Folders</h2>
        <ul class="list-unstyled">
            <li>
                <button type="button" class="btn btn-link p-0 @(FolderId is null ? "fw-bold" : null)"
                        @onclick="() => SelectFolderAsync(null)">
                    All folders
                </button>
            </li>
            @foreach (var folder in Folders ?? [])
            {
                <MediaFolderBranch Folder="folder" SelectedId="FolderId" OnSelect="SelectFolderAsync" />
            }
        </ul>

        <AuthorizeView Roles="@CmsRoles.ContentEditors" Context="editor">
            <label class="form-label" for="new-folder">New folder in @FolderLabel</label>
            <div class="input-group input-group-sm mb-3">
                <input id="new-folder" class="form-control" @bind="NewFolderName" />
                <button type="button" class="btn btn-outline-secondary" disabled="@IsBusy"
                        @onclick="CreateFolderAsync">
                    Add
                </button>
            </div>
        </AuthorizeView>
    </div>

    <div class="col-md-9">
        <div class="row g-2 mb-3">
            <div class="col-sm-5">
                <label class="form-label" for="media-search">Search</label>
                <input id="media-search" class="form-control" value="@Search" placeholder="Name, title, or alt text"
                       @onchange="async e => { Search = e.Value?.ToString(); await FilterChangedAsync(); }" />
            </div>

            @* Hidden when the caller already restricts the kind: a picker for images has nothing to
               offer here but a way to break itself. *@
            @if (RestrictToKind is null)
            {
                <div class="col-sm-3">
                    <label class="form-label" for="media-kind">Kind</label>
                    <select id="media-kind" class="form-select" value="@Kind"
                            @onchange="async e => { Kind = e.Value?.ToString(); await FilterChangedAsync(); }">
                        <option value="">Any</option>
                        <option value="Image">Image</option>
                        <option value="Document">Document</option>
                        <option value="Video">Video</option>
                        <option value="Audio">Audio</option>
                    </select>
                </div>
            }

            <div class="col-sm-4 d-flex align-items-end gap-3">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="media-unused" checked="@UnusedOnly"
                           @onchange="async e => { UnusedOnly = (bool?)e.Value ?? false; await FilterChangedAsync(); }" />
                    <label class="form-check-label" for="media-unused">Unused only</label>
                </div>

                @if (AllowRecycleBin)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="media-bin" checked="@ShowBin"
                               @onchange="async e => { ShowBin = (bool?)e.Value ?? false; await FilterChangedAsync(); }" />
                        <label class="form-check-label" for="media-bin">Recycle bin</label>
                    </div>
                }
            </div>
        </div>

        <AuthorizeView Roles="@CmsRoles.ContentEditors" Context="editor">
            <div class="border rounded p-3 mb-3">
                <h2 class="h6">Upload into @FolderLabel</h2>

                <div class="row g-2 align-items-end">
                    <div class="col-sm-6">
                        <label class="form-label" for="upload-alt">Alternative text</label>
                        <input id="upload-alt" class="form-control" @bind="UploadAltText"
                               disabled="@UploadIsDecorative" />
                        <div class="form-text">
                            Required for images, unless the file is decorative. Publishing a page
                            whose picture has neither fails validation.
                        </div>
                    </div>

                    <div class="col-sm-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="upload-decorative"
                                   @bind="UploadIsDecorative" />
                            <label class="form-check-label" for="upload-decorative">Decorative</label>
                        </div>
                    </div>

                    <div class="col-sm-4">
                        <label class="form-label" for="upload-files">Files</label>
                        <InputFile id="upload-files" class="form-control" multiple OnChange="UploadAsync"
                                   disabled="@IsBusy" />
                    </div>
                </div>

                @* Only a chunked upload can report anything meaningful here; a small file goes in one
                   request and jumps straight to done (task P5-08). *@
                @if (UploadProgress is { } fraction)
                {
                    <div class="progress mt-3" role="progressbar" aria-label="Upload progress"
                         aria-valuenow="@((int)(fraction * 100))" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" style="width: @((int)(fraction * 100))%">
                            @((int)(fraction * 100))%
                        </div>
                    </div>
                }
            </div>
        </AuthorizeView>

        @if (Items is null)
        {
            <p role="status">Loading the library…</p>
        }
        else if (Items.Items.Count == 0)
        {
            <p>Nothing here. Try another folder, or clear the filters.</p>
        }
        else
        {
            <ul class="list-unstyled d-flex flex-wrap gap-3">
                @foreach (var item in Items.Items)
                {
                    var links = Links.GetValueOrDefault(item.Id);

                    <li class="border rounded p-2" style="width: 12rem">
                        @* A thumbnail when the pipeline can produce one, and the file's own name when
                           it cannot — a document has no rendition and an <img> at one would be a
                           broken image where a label belongs. *@
                        @if (links?.ThumbnailUrl is { Length: > 0 } thumbnail)
                        {
                            @* The alt is the library's own description when there is one and empty
                               when there is not — never absent. An <img> with no alt attribute at
                               all is announced as its file name, which for a content-addressed
                               thumbnail is a hex string; the tile's own text below already names
                               the file, so empty is the honest reading of an undescribed one. *@
                            <img src="@thumbnail" alt="@Describe(item)"
                                 class="img-fluid mb-2" loading="lazy" decoding="async" />
                        }
                        else
                        {
                            <p class="small text-body-secondary mb-2">@item.Kind</p>
                        }

                        <p class="small text-truncate mb-1" title="@item.OriginalFileName">
                            @item.OriginalFileName
                        </p>

                        @if (item.Width is { } width && item.Height is { } height)
                        {
                            <p class="small text-body-secondary mb-1">@width × @height</p>
                        }

                        @if (item.Kind == "Image" && !item.IsDecorative && string.IsNullOrWhiteSpace(item.AltText))
                        {
                            @* Surfaced in the grid rather than only at publish time, because the
                               person who can fix it fastest is the one looking at the picture. *@
                            <p class="small text-danger mb-1">No alt text</p>
                        }

                        @if (OnPicked.HasDelegate)
                        {
                            <button type="button" class="btn btn-sm btn-primary w-100"
                                    @onclick="() => PickAsync(item)">
                                Choose
                            </button>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-secondary w-100"
                               href="@($"/admin/media/{item.Id}")">Details</a>
                        }
                    </li>
                }
            </ul>

            <div class="d-flex justify-content-between align-items-center">
                <span class="small text-body-secondary">
                    @(Items.Skip + 1)–@(Items.Skip + Items.Items.Count) of @Items.Total
                </span>

                <div class="btn-group">
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(Items.Skip == 0)"
                            @onclick="() => PageAsync(-1)">
                        Previous
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(!HasMore)"
                            @onclick="() => PageAsync(1)">
                        Next
                    </button>
                </div>
            </div>
        }
    </div>
</div>

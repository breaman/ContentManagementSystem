@page "/admin/media/{Id:int}"
@rendermode InteractiveWebAssembly
@attribute [Authorize(Roles = CmsRoles.ContentReaders)]
@using ContentManagementSystem.Client.Components.Admin.Reusable
@using ContentManagementSystem.Client.Components.Admin.Structure
@using ContentManagementSystem.Shared.Contracts.Media
@using ContentManagementSystem.Shared.Contracts.Security
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>@(Item?.OriginalFileName ?? "Media")</PageTitle>

@if (Item is null)
{
    <p role="status">Loading…</p>
}
else
{
    <nav aria-label="Breadcrumb">
        <a href="/admin/media">← Media library</a>
    </nav>

    <h1 class="h3">@(string.IsNullOrWhiteSpace(Item.Title) ? Item.OriginalFileName : Item.Title)</h1>
    <p class="text-body-secondary">
        <code>@Item.ContentType</code> · @Item.Kind ·
        @if (Item.Width is { } width && Item.Height is { } height)
        {
            <text>@width × @height · </text>
        }
        @(Item.SizeBytes / 1024) KB · edits generation @Item.EditsVersion
    </p>

    <DiagnosticList Diagnostics="Errors" Heading="That did not happen" />

    @if (Notice is { Length: > 0 })
    {
        <p class="alert alert-success" role="status">@Notice</p>
    }

    <div class="row">
        <div class="col-md-5">
            @* The picture as it currently stands — that is, with the saved edits applied. It is
               fetched at a signed URL like every other consumer's, so what an editor judges a crop
               by is exactly what a visitor will see. *@
            @* Empty rather than absent when nobody has described it: an <img> with no alt is
               announced by its file name, and the heading above already carries that. *@
            @if (Links?.PreviewUrl is { Length: > 0 } preview)
            {
                <img src="@preview" alt="@PreviewAlt"
                     class="img-fluid border rounded mb-2" decoding="async" />
            }
            else
            {
                <p class="text-body-secondary">No preview: this file has no rendition pipeline.</p>
            }

            @if (Links?.OriginalUrl is { Length: > 0 } original)
            {
                <p><a href="@original" download>Download the original</a></p>
            }
        </div>

        <div class="col-md-7">
            <h2 class="h5">Description</h2>

            <AuthorizeView Roles="@CmsRoles.ContentEditors" Context="editor">
                <EditForm Model="Metadata" OnValidSubmit="SaveMetadataAsync" FormName="media-metadata">
                    <fieldset disabled="@IsBusy">
                        <div class="mb-3">
                            <label class="form-label" for="alt-text">Alternative text</label>
                            <input id="alt-text" class="form-control" @bind="Metadata.AltText"
                                   disabled="@Metadata.IsDecorative" />
                            <div class="form-text">
                                What somebody who cannot see the picture needs to know. Required for
                                images unless the file is decorative — publishing a page whose
                                picture has neither fails validation.
                            </div>
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="is-decorative"
                                   @bind="Metadata.IsDecorative" />
                            <label class="form-check-label" for="is-decorative">
                                Decorative — renders <code>alt=""</code> and is skipped by screen readers
                            </label>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="title">Title</label>
                            <input id="title" class="form-control" @bind="Metadata.Title" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="caption">Caption</label>
                            <input id="caption" class="form-control" @bind="Metadata.Caption" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="credit">Credit</label>
                            <input id="credit" class="form-control" @bind="Metadata.Credit" />
                        </div>

                        <button type="submit" class="btn btn-primary">Save description</button>
                    </fieldset>
                </EditForm>
            </AuthorizeView>
        </div>
    </div>

    @if (Item.Kind == "Image")
    {
        <AuthorizeView Roles="@CmsRoles.ContentEditors" Context="editor">
            <h2 class="h5 mt-4">Picture</h2>
            <p class="text-body-secondary">
                These apply to <strong>every</strong> page showing this picture. The uploaded bytes
                are never changed, so reverting is always available — and applying an edit changes
                every image URL the site emits, which is what clears browser and CDN caches with no
                purge to run.
            </p>

            <EditForm Model="Geometry" OnValidSubmit="SaveGeometryAsync" FormName="media-geometry">
                <fieldset disabled="@IsBusy">
                    <div class="row g-3">
                        <div class="col-sm-3">
                            <label class="form-label" for="rotate">Rotate</label>
                            <select id="rotate" class="form-select" @bind="Geometry.Rotate">
                                <option value="0">None</option>
                                <option value="90">90° clockwise</option>
                                <option value="180">180°</option>
                                <option value="270">270° clockwise</option>
                            </select>
                        </div>

                        <div class="col-sm-3">
                            <label class="form-label" for="flip">Flip</label>
                            <select id="flip" class="form-select" @bind="Geometry.Flip">
                                <option value="@FlipDirection.None">None</option>
                                <option value="@FlipDirection.Horizontal">Left to right</option>
                                <option value="@FlipDirection.Vertical">Top to bottom</option>
                            </select>
                            <div class="form-text">Applied after the rotation.</div>
                        </div>
                    </div>

                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" id="has-crop" @bind="Geometry.HasCrop" />
                        <label class="form-check-label" for="has-crop">Crop</label>
                    </div>

                    @* Fractions of the picture rather than pixels, because that is what is stored:
                       a crop written this way survives replacing the file with a higher-resolution
                       original, where a pixel rectangle would silently move. *@
                    <div class="row g-3 mt-0">
                        <div class="col-sm-3">
                            <label class="form-label" for="crop-x">Left</label>
                            <input id="crop-x" class="form-control" type="number" step="0.01" min="0" max="1"
                                   @bind="Geometry.CropX" disabled="@(!Geometry.HasCrop)" />
                        </div>
                        <div class="col-sm-3">
                            <label class="form-label" for="crop-y">Top</label>
                            <input id="crop-y" class="form-control" type="number" step="0.01" min="0" max="1"
                                   @bind="Geometry.CropY" disabled="@(!Geometry.HasCrop)" />
                        </div>
                        <div class="col-sm-3">
                            <label class="form-label" for="crop-w">Width</label>
                            <input id="crop-w" class="form-control" type="number" step="0.01" min="0" max="1"
                                   @bind="Geometry.CropWidth" disabled="@(!Geometry.HasCrop)" />
                        </div>
                        <div class="col-sm-3">
                            <label class="form-label" for="crop-h">Height</label>
                            <input id="crop-h" class="form-control" type="number" step="0.01" min="0" max="1"
                                   @bind="Geometry.CropHeight" disabled="@(!Geometry.HasCrop)" />
                        </div>
                    </div>

                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" id="has-focal"
                               @bind="Geometry.HasFocalPoint" />
                        <label class="form-check-label" for="has-focal">
                            Focal point — the part to keep visible when a template crops to another shape
                        </label>
                    </div>

                    <div class="row g-3 mt-0">
                        <div class="col-sm-3">
                            <label class="form-label" for="focal-x">Across</label>
                            <input id="focal-x" class="form-control" type="number" step="0.01" min="0" max="1"
                                   @bind="Geometry.FocalX" disabled="@(!Geometry.HasFocalPoint)" />
                        </div>
                        <div class="col-sm-3">
                            <label class="form-label" for="focal-y">Down</label>
                            <input id="focal-y" class="form-control" type="number" step="0.01" min="0" max="1"
                                   @bind="Geometry.FocalY" disabled="@(!Geometry.HasFocalPoint)" />
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-primary">Apply to every usage</button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="RevertAsync">
                            Revert to the original
                        </button>
                    </div>
                </fieldset>
            </EditForm>
        </AuthorizeView>
    }

    <AuthorizeView Roles="@CmsRoles.ContentEditors" Context="editor">
        <h2 class="h5 mt-4">Replace the file</h2>
        <p class="text-body-secondary">
            Keeps this item's id, so every page already showing it shows the new file — without any
            of them being edited or republished.
        </p>
        <label class="form-label" for="replace-file">New file</label>
        <InputFile id="replace-file" class="form-control" OnChange="ReplaceAsync" disabled="@IsBusy" />
    </AuthorizeView>

    <h2 class="h5 mt-4">Where this is used</h2>
    <WhereUsedPanel Impact="Usage" Verb="show this file" />

    <AuthorizeView Roles="@CmsRoles.ContentEditors" Context="editor">
        <h2 class="h5 mt-4">Lifecycle</h2>

        <div class="d-flex gap-2">
            @if (IsInBin)
            {
                <button type="button" class="btn btn-outline-secondary" disabled="@IsBusy"
                        @onclick="RestoreAsync">
                    Restore from the bin
                </button>
            }
            else
            {
                @* Deliberately not reference-guarded: a soft delete is reversible, so the right
                   answer to "this is on twelve pages" is to hide it and let the editor find them. *@
                <button type="button" class="btn btn-outline-danger" disabled="@IsBusy" @onclick="DeleteAsync">
                    Move to the recycle bin
                </button>
            }

            <AuthorizeView Roles="@CmsRoles.Administrator" Context="administrator">
                <button type="button" class="btn btn-danger" disabled="@IsBusy" @onclick="PurgeAsync">
                    Delete permanently
                </button>
            </AuthorizeView>
        </div>

        <p class="form-text">
            Permanent deletion removes the bytes and cannot be undone. It is refused while anything
            still shows the file — the list above is what would have to be changed first.
        </p>
    </AuthorizeView>
}

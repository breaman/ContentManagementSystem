@namespace ContentManagementSystem.Client.Components.Admin.Canvas
@inherits ContentManagementSystem.Client.Components.Admin.Fields.FieldEditorBase

@* No form-floating wrapper here, and that is not an oversight: the zone's label is the card's
   heading, and a floating label would print the zone's name a second time inside its own control. *@

@if (IsText)
{
    <textarea id="@Field.ControlId" class="form-control" rows="4"
              aria-labelledby="@Field.LabelledBy"
              aria-describedby="@Field.DescribedBy"
              aria-invalid="@Field.AriaInvalid"
              disabled="@Field.Disabled"
              value="@Text"
              @onchange="OnChangedAsync"></textarea>
}
else
{
    <textarea id="@Field.ControlId" class="form-control font-monospace" rows="4" readonly
              aria-labelledby="@Field.LabelledBy"
              aria-describedby="@Field.DescribedBy"
              value="@Stored"></textarea>
    <p class="form-text">
        Shown as stored. No editor is registered for <code>@Field.Slot.FieldTypeKey</code> in this
        build, so this zone is edited elsewhere and saved back untouched.
    </p>
}

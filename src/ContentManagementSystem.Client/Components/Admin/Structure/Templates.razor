@page "/admin/structure/templates"
@rendermode InteractiveWebAssembly
@attribute [Authorize(Roles = CmsRoles.StructureEditors)]
@using ContentManagementSystem.Shared.Contracts.Security
@using ContentManagementSystem.Shared.Contracts.Structure

<PageTitle>Templates</PageTitle>

<h1>Templates</h1>
<p class="text-body-secondary">
    A template is a page shape: a stable key, a Razor component that lays out the markup, and the
    zones an editor fills in.
</p>

<DiagnosticList Diagnostics="Errors" Heading="The template was not created" />
<DiagnosticList Diagnostics="Warnings" IsError="false" Heading="Saved, with warnings" />

@if (Items is null)
{
    <p role="status">Loading templates…</p>
}
else if (Items.Count == 0)
{
    <p>No templates yet. Create one below, or deploy a component carrying <code>[CmsTemplate]</code>.</p>
}
else
{
    <table class="table">
        <caption>@Items.Count template(s)</caption>
        <thead>
            <tr>
                <th scope="col">Key</th>
                <th scope="col">Name</th>
                <th scope="col">Zones</th>
                <th scope="col">Revision</th>
                <th scope="col">State</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var template in Items)
            {
                <tr>
                    <th scope="row">
                        <a href="@($"/admin/structure/templates/{template.Id}")">@template.Key</a>
                    </th>
                    <td>@template.Name</td>
                    <td>@template.ZoneCount</td>
                    <td>@template.CurrentRevision</td>
                    <td>
                        @if (template.IsOrphaned)
                        {
                            <span class="badge text-bg-warning">Orphaned — no deployed component</span>
                        }
                        else if (!template.IsEnabled)
                        {
                            <span class="badge text-bg-secondary">Disabled</span>
                        }
                        else
                        {
                            <span class="badge text-bg-success">Ready</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h2 class="h5 mt-4">Create a template</h2>

<EditForm Model="Form" OnValidSubmit="CreateAsync" FormName="create-template">
    <DataAnnotationsValidator />

    <fieldset disabled="@IsBusy">
        <div class="form-floating mb-3">
            <InputText @bind-Value="Form.Key" id="template-key" class="form-control"
                       placeholder="marketing-landing" />
            <label for="template-key">Key</label>
            <ValidationMessage For="() => Form.Key" class="text-danger" />
            <div class="form-text">Chosen once. Every payload authored against the template quotes it.</div>
        </div>

        <div class="form-floating mb-3">
            <InputText @bind-Value="Form.Name" id="template-name" class="form-control"
                       placeholder="Marketing Landing Page" />
            <label for="template-name">Display name</label>
            <ValidationMessage For="() => Form.Name" class="text-danger" />
        </div>

        <div class="form-floating mb-3">
            <InputText @bind-Value="Form.Description" id="template-description" class="form-control"
                       placeholder="Hero, flexible body, and a shared footer." />
            <label for="template-description">Help text</label>
            <ValidationMessage For="() => Form.Description" class="text-danger" />
        </div>

        <button type="submit" class="btn btn-primary">Create template</button>
    </fieldset>
</EditForm>

<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;" aria-live="polite" aria-atomic="true">
    @foreach (var toast in _toasts)
    {
        <div class="toast text-bg-@GetBootstrapClass(toast.Type) border-0"
             id="toast-@toast.Id"
             role="alert"
             aria-live="assertive"
             aria-atomic="true"
             data-bs-autohide="true"
             data-bs-delay="5000">
            <div class="d-flex">
                <div class="toast-body">
                    @if (!string.IsNullOrWhiteSpace(toast.Heading))
                    {
                        <strong class="me-auto">@toast.Heading</strong>
                        <br />
                    }
                    @toast.Message
                </div>
                <button type="button"
                        class="btn-close me-2 m-auto"
                        @onclick="() => RemoveToast(toast.Id)"
                        aria-label="Close">
                </button>
            </div>
        </div>
    }
</div>
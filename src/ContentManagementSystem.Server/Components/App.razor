@inject ContentManagementSystem.Server.Security.ICspNonce Nonce

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* The per-request nonce, exposed to JavaScript because the library that needs it runs in the
       browser and the value is generated here (D13, tasks P6-08 and P9-01). CodeMirror injects its
       theme as a <style> element at runtime and reads this through EditorView.cspNonce; without it
       the editor renders unstyled, and does so silently. *@
    <meta name="csp-nonce" content="@Nonce.Value" />
    <ResourcePreloader />
    @* Bootstrap Icons is served from this origin rather than jsDelivr. A CDN in any fetch-directive
       would mean either a policy with a third-party host in it or a stylesheet that silently fails to
       load, and an icon font that does not arrive leaves every button in the backoffice showing a
       replacement glyph. Copied out of node_modules by the CopyBootstrapIcons target (task P9-01). *@
    <link rel="stylesheet" href="@Assets["css/bootstrap-icons.min.css"]" />
    <link rel="stylesheet" href="@Assets["css/site.css"]" />
    @* Component-scoped stylesheets, bundled across the server and the WebAssembly client. The
       backoffice shell is the first component to have one (task P6-01), so this stopped being an
       empty file at that point. *@
    <link rel="stylesheet" href="@Assets["ContentManagementSystem.Server.styles.css"]" />
    @* Blazor renders the import map as an inline <script>, which script-src 'self' blocks — and the
       symptom is a backoffice whose modules resolve to nothing. The nonce is the same one above:
       one request, one value. *@
    <ImportMap nonce="@Nonce.Value" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
<Routes />
<script src="@Assets["_framework/blazor.web.js"]"></script>
<script src="@Assets["js/bootstrap.bundle.min.js"]"></script>
<script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
</body>
</html>

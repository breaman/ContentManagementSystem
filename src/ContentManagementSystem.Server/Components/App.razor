@inject ContentManagementSystem.Server.Services.IStyleNonce Nonce

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* The per-request style nonce, exposed to JavaScript because the library that needs it runs in
       the browser and the value is generated here (D13, task P6-08). CodeMirror injects its theme as
       a <style> element at runtime and reads this through EditorView.cspNonce; without it the editor
       renders unstyled, and does so silently. *@
    <meta name="csp-nonce" content="@Nonce.Value" />
    <ResourcePreloader />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="@Assets["css/site.css"]" />
    @* Component-scoped stylesheets, bundled across the server and the WebAssembly client. The
       backoffice shell is the first component to have one (task P6-01), so this stopped being an
       empty file at that point. *@
    <link rel="stylesheet" href="@Assets["ContentManagementSystem.Server.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
<Routes />
<script src="@Assets["_framework/blazor.web.js"]"></script>
<script src="@Assets["js/bootstrap.bundle.min.js"]"></script>
<script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
</body>
</html>
